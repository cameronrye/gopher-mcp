# Gopher & Gemini MCP Server Configuration
# Copy this file to .env and customize as needed.
#
# Only the variables listed here are read by the server. Gopher settings use the
# GOPHER_ prefix, Gemini settings use the GEMINI_ prefix, and server/logging
# settings use the GOPHER_MCP_ prefix. Unprefixed or unknown variables are ignored.
#
# Every value below is the default, so this file is a no-op as shipped: uncomment
# and change only what you need.
#
# THREE CONVENTIONS TO KNOW
#
# 1. List-valued variables (*_ALLOWED_HOSTS, *_ALLOWED_PORTS,
#    GEMINI_DENIED_MIME_TYPES) accept either the comma-separated form (a,b) or a
#    JSON array (["a", "b"]). Whitespace around each entry is stripped. Leave one
#    unset or empty to mean "no restriction". A value that is PRESENT but names
#    no entries -- " , ", or "$A,$B" where both shell variables are empty -- is a
#    STARTUP ERROR, because an empty allowlist cannot be told apart from an
#    absent one and would silently drop the restriction you meant to apply. A
#    port outside 1-65535 in an allowlist is a startup error for the same reason.
#
# 2. PATH-valued variables treat a blank value and a commented-out line as the
#    same thing: both mean "use the default". Writing
#    GEMINI_TOFU_STORAGE_PATH= with nothing after the "=" is equivalent to
#    leaving the line commented out, so either spelling is safe.
#
# 3. A cache TTL of 0 DISABLES caching. It does not mean "never expire": an entry
#    stored with a zero lifetime would expire the instant it was written, so the
#    cache is switched off instead.

# =============================================================================
# GOPHER PROTOCOL CONFIGURATION
# =============================================================================

# Maximum response size in bytes (default: 1048576 = 1MB; range 1024-104857600)
GOPHER_MAX_RESPONSE_SIZE=1048576

# Overall deadline for one fetch, in seconds -- DNS, connect, send and read all
# draw down this single budget (default: 30; must be > 0, at most 300)
GOPHER_TIMEOUT_SECONDS=30

# Enable response caching (default: true)
GOPHER_CACHE_ENABLED=true

# Cache time-to-live in seconds (default: 300 = 5 minutes; max 86400).
# 0 disables caching entirely -- see convention 3 above.
GOPHER_CACHE_TTL_SECONDS=300

# Maximum number of cache entries (default: 1000, LRU eviction; range 1-100000)
GOPHER_MAX_CACHE_ENTRIES=1000

# Allowed hosts, comma-separated or a JSON array (default: unset = all hosts).
# Example: GOPHER_ALLOWED_HOSTS=gopher.floodgap.com,gopher.quux.org
# Example: GOPHER_ALLOWED_HOSTS=["gopher.floodgap.com", "gopher.quux.org"]
GOPHER_ALLOWED_HOSTS=

# Allow connecting to loopback/private/internal addresses (default: false).
# Leave false in production; enabling it disables SSRF protection for Gopher.
GOPHER_ALLOW_LOCAL_HOSTS=false

# Optional positive port allowlist, comma-separated or a JSON array. When set,
# only these ports may be connected to, closing the arbitrary-port port-scanning
# gap. Unset = any non-dangerous port. Example: GOPHER_ALLOWED_PORTS=70
GOPHER_ALLOWED_PORTS=

# Maximum selector length in characters (default: 1024; range 1-65536)
GOPHER_MAX_SELECTOR_LENGTH=1024

# Maximum search query length in characters (default: 256; range 1-4096)
GOPHER_MAX_SEARCH_LENGTH=256

# Maximum characters of rendered text returned to the model (default: 50000;
# 0 = unlimited). Responses longer than this are truncated and flagged.
GOPHER_MAX_RENDERED_CHARS=50000

# Maximum number of Gopher menu items returned to the model (default: 1000;
# 0 = unlimited). A large directory is truncated to this many items and flagged.
GOPHER_MAX_MENU_ITEMS=1000

# Per-host outbound rate limit, in requests per minute (default: 60 = one per
# second, per host; 0 = unlimited). On by default as politeness toward the small
# machines that serve most of Gopherspace.
GOPHER_REQUESTS_PER_MINUTE=60

# Cap on simultaneous in-flight fetches (default: 5, matching the batch tools'
# own concurrency; 0 = unlimited)
GOPHER_MAX_CONCURRENT_REQUESTS=5

# Fetch and honour /robots.txt from the host root before retrieving a resource,
# per the convention Veronica-2 documents (default: true). The round-trip it
# costs is cached per host for GOPHER_ROBOTS_CACHE_TTL_SECONDS. Fails OPEN:
# Gopher has no status codes, so an unreachable policy cannot be told apart from
# an absent one. Set false to fetch without consulting a policy.
GOPHER_RESPECT_ROBOTS_TXT=true

# How long a fetched robots policy stays valid, in seconds (default: 86400 = 24
# hours, the maximum RFC 9309 section 2.4 permits; range 0-604800)
GOPHER_ROBOTS_CACHE_TTL_SECONDS=86400

# Also honour Disallow rules aimed at named AI crawler tokens -- ClaudeBot,
# GPTBot, CCBot and friends (default: true). Only applies when
# GOPHER_RESPECT_ROBOTS_TXT is enabled.
GOPHER_ROBOTS_HONOR_AI_TOKENS=true

# =============================================================================
# GEMINI PROTOCOL CONFIGURATION
# =============================================================================

# Maximum response size in bytes (default: 1048576 = 1MB; range 1024-104857600)
GEMINI_MAX_RESPONSE_SIZE=1048576

# ONE wire-time budget for an entire fetch, in seconds -- not a per-phase
# timeout. DNS, connect and TLS handshake, the TOFU trust-store write, sending
# the request and reading the response all draw it down, and when
# GEMINI_RESPECT_ROBOTS_TXT is on the /robots.txt probe spends from it too.
# (default: 30; must be > 0, at most 300)
GEMINI_TIMEOUT_SECONDS=30

# Enable response caching (default: true)
GEMINI_CACHE_ENABLED=true

# Cache time-to-live in seconds (default: 300 = 5 minutes; max 86400).
# 0 disables caching entirely -- see convention 3 above.
GEMINI_CACHE_TTL_SECONDS=300

# Maximum number of cache entries (default: 1000, LRU eviction; range 1-100000)
GEMINI_MAX_CACHE_ENTRIES=1000

# Allowed hosts, comma-separated or a JSON array (default: unset = all hosts).
# Example: GEMINI_ALLOWED_HOSTS=geminiprotocol.net,warmedal.se
# Example: GEMINI_ALLOWED_HOSTS=["geminiprotocol.net", "warmedal.se"]
GEMINI_ALLOWED_HOSTS=

# Allow connecting to loopback/private/internal addresses (default: false).
# Leave false in production; enabling it disables SSRF protection for Gemini.
GEMINI_ALLOW_LOCAL_HOSTS=false

# Optional positive port allowlist, comma-separated or a JSON array. When set,
# only these ports may be connected to, closing the arbitrary-port port-scanning
# gap. Unset = any non-dangerous port. Example: GEMINI_ALLOWED_PORTS=1965
GEMINI_ALLOWED_PORTS=

# Enable TOFU (Trust-on-First-Use) certificate validation (default: true).
# Gemini TLS runs without CA-chain validation, so the pinned fingerprint is the
# ONLY thing authenticating a server. With this off, connections are
# unauthenticated and the gemini_trust_* tools have no store to act on.
GEMINI_TOFU_ENABLED=true

# TOFU storage file path. Leave this commented out -- or blank, which means the
# same thing (convention 2) -- for the default ~/.gemini/tofu.json.
# GEMINI_TOFU_STORAGE_PATH=/custom/path/tofu.json

# Reject certificates outside their validity window (default: false).
# When true, an expired or not-yet-valid certificate fails closed.
GEMINI_TOFU_REJECT_EXPIRED=false

# Store client certificates and attach one automatically when it covers the
# requested host/port/path scope (default: true). Nothing is ever created on
# demand: answering status 60 (certificate required) takes an explicit
# gemini_client_cert_update call, because a client certificate is a persistent
# identity the capsule can use to link every in-scope visit. With this false
# there is no store at all and both certificate tools refuse.
GEMINI_CLIENT_CERTS_ENABLED=true

# Client certificate storage directory. Leave this commented out -- or blank,
# which means the same thing -- for the default ~/.gemini/certs/.
# GEMINI_CLIENT_CERTS_STORAGE_PATH=/custom/path/certs/

# Maximum characters of rendered text returned to the model (default: 50000;
# 0 = unlimited). Responses longer than this are truncated and flagged.
GEMINI_MAX_RENDERED_CHARS=50000

# Per-host outbound rate limit, in requests per minute (default: 60 = one per
# second, per host; 0 = unlimited). A status-44 SLOW_DOWN response is always
# honoured regardless of this setting.
GEMINI_REQUESTS_PER_MINUTE=60

# Cap on simultaneous in-flight fetches (default: 5, matching the batch tools'
# own concurrency; 0 = unlimited)
GEMINI_MAX_CONCURRENT_REQUESTS=5

# MIME types to deny, comma-separated or a JSON array (default: empty = no
# content filtering). Supports type/* wildcards.
# Example: GEMINI_DENIED_MIME_TYPES=image/*,application/octet-stream
GEMINI_DENIED_MIME_TYPES=

# Fetch and honour /robots.txt from the capsule root before retrieving a
# resource, per the Gemini companion specification (default: true). The probe is
# cached per host, but note it spends from the same GEMINI_TIMEOUT_SECONDS
# budget as the fetch it guards. Fails CLOSED on a temporary (4x) failure;
# 51 NOT FOUND means "no policy". Set false to fetch without a policy check.
GEMINI_RESPECT_ROBOTS_TXT=true

# How long a fetched robots policy stays valid, in seconds (default: 86400 = 24
# hours; range 0-604800)
GEMINI_ROBOTS_CACHE_TTL_SECONDS=86400

# Also honour Disallow rules aimed at named AI crawler tokens -- ClaudeBot,
# GPTBot, CCBot and friends (default: true). Only applies when
# GEMINI_RESPECT_ROBOTS_TXT is enabled.
GEMINI_ROBOTS_HONOR_AI_TOKENS=true

# =============================================================================
# SERVER CONFIGURATION (GOPHER_MCP_ prefix)
# =============================================================================

# Log level (default: INFO). Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
GOPHER_MCP_LOG_LEVEL=INFO

# Emit structured (JSON) logs vs. console rendering (default: true)
GOPHER_MCP_STRUCTURED_LOGGING=true

# Log file path. Logs always go to stderr (never stdout, which carries the MCP
# protocol stream); set this to also tee them to a file. Leave it commented out
# -- or blank, which means the same thing -- to log only to stderr.
# GOPHER_MCP_LOG_FILE_PATH=/path/to/gopher-mcp.log
